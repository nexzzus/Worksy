@model Worksy.Web.DTOs.WorksyRoleDTO
@{
    ViewBag.Title = "Nuevo Rol";
    ViewData["HeaderClass"] = "sticky-top";
    ViewData["HideFooter"] = true;
    ViewData["BreadcrumbParent"] = "Roles";
    ViewData["BreadcrumbChild"] = "Nuevo Rol";
}

<div class="container-lg">
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0">Crear Rol</h2>
    </div>

    <form class="row g-3" asp-action="Create" method="post" id="frmCreate">

        @await Html.PartialAsync("_Role", Model)

    </form>
    @await Html.PartialAsync("_Permissions", Model)


    <div class="col-12 mb-3">
        <button type="submit" class="btn btn-primary" form="frmCreate" id="btnCreate">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </div>


</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_Validationscriptspartial");
    }
    <script>
        $(document).ready(function () {
            $('#btnCreate').click(function (event) {
                const permissions = $('.permission:checked');

                let permissionIds = [];

                permissions.each(function () {
                    const permissionId = $(this).data('permission-id');
                    permissionIds.push(permissionId);
                });
                $('#permissionIds').val(JSON.stringify(permissionIds));

            });
        });
    </script>
}