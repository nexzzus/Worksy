@model ResetPasswordViewModel

@{
    ViewBag.Title = "Restablecer Contraseña";
    Layout = "_Layout";
    ViewData["HeaderClass"] = "sticky-top";
    ViewData["HideFooter"] = true;
}

<form asp-action="ResetPassword" method="POST">
    <input type="hidden" asp-for="Token"/>
    <input type="hidden" asp-for="Email"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="form-floating mb-3">
        <input type="password" asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña"/>
        <label asp-for="NewPassword"></label>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    
    <div class="form-floating mb-3">
        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña"/>
        <label asp-for="ConfirmPassword"></label>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary w-100">Restablecer Contraseña</button>

</form>