@model RegisterViewModel
@{
    ViewBag.Title = "Crear usuario";
    ViewData["HeaderClass"] = "sticky-top";
    ViewData["HideFooter"] = true;
    ViewData["BreadcrumbParent"] = "Usuario";
    ViewData["BreadcrumbChild"] = "Nuevo usuario";
}

<div class="container-lg">
    <div class="container mb-5">
        <h2 class="mb-4">Crear usuario</h2>

        <form asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input class="form-control" asp-for="Email" placeholder="correo@ejemplo.com" />
                <span class="text-danger small" asp-validation-for="Email"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombres</label>
                    <input class="form-control" asp-for="FirstName" />
                    <span class="text-danger small" asp-validation-for="FirstName"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellidos</label>
                    <input class="form-control" asp-for="LastName" />
                    <span class="text-danger small" asp-validation-for="LastName"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <input class="form-control" asp-for="PhoneNumber" />
                <span class="text-danger small" asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección</label>
                <input class="form-control" asp-for="Address" />
                <span class="text-danger small" asp-validation-for="Address"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Rol</label>
                <select asp-for="RoleId" asp-items="Model.Roles" class="form-control"></select>
                <span class="text-danger small" asp-validation-for="RoleId"></span>
            </div>

            <!-- Contraseña -->
            <div class="form-outline mb-3 position-relative">
                <label class="form-label" asp-for="Password">Contraseña</label>
                <input asp-for="Password" id="passwordField" class="form-control" type="password" placeholder="Crea una contraseña segura" />
                <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y me-2" onclick="togglePassword('passwordField', 'iconPassword')">
                    <img id="iconPassword" src="~/img/ojo.png" style="width: 20px; margin-top: 35px">
                </button>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Confirmar contraseña -->
            <div class="form-outline mb-3 position-relative">
                <label class="form-label" asp-for="ConfirmPassword">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" id="confirmPasswordField" class="form-control" type="password" placeholder="Confirmar contraseña" />
                <button type="button" class="btn position-absolute top-50 end-0 translate-middle-y me-2" onclick="togglePassword('confirmPasswordField', 'iconConfirmPassword')">
                    <img id="iconConfirmPassword" src="~/img/ojo.png" style="width: 20px; padding-top: 35px">
                </button>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-action="UsersTable" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script src="~/js/viewpassword.js"></script>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
