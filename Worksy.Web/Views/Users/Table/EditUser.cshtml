@model UpdateUserAdmin
@{
    ViewBag.Title = "Editar usuario";
    ViewData["HeaderClass"] = "sticky-top";
    ViewData["HideFooter"] = true;
    ViewData["BreadcrumbParent"] = "Usuario";
    ViewData["BreadcrumbChild"] = "Editar usuario";
}

<div class="container-lg">
    <div class="container mb-5">
        <h2 class="mb-4">Editar usuario</h2>

        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id"/>

            <div class="mb-3">
                <label class="form-label">Correo (Username)</label>
                <input class="form-control" asp-for="Email"/>
                <span class="text-danger small" asp-validation-for="Email"></span>
                <div class="form-text">Si cambias el correo, se actualizará también el nombre de usuario.</div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombres</label>
                    <input class="form-control" asp-for="FirstName"/>
                    <span class="text-danger small" asp-validation-for="FirstName"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellidos</label>
                    <input class="form-control" asp-for="LastName"/>
                    <span class="text-danger small" asp-validation-for="LastName"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <input class="form-control" asp-for="PhoneNumber"/>
                <span class="text-danger small" asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección</label>
                <input class="form-control" asp-for="Address"/>
                <span class="text-danger small" asp-validation-for="Address"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Rol</label>
                <select asp-for="WorksyRoleId" asp-items="Model.Roles" class="form-control">
                </select>
                <span class="text-danger small" asp-validation-for="WorksyRoleId"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="UsersTable" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
