@using System.Security.Claims
@using Worksy.Web.Core
@model List<Message>
@inject IUserService _UserService

@{
    
    ViewData["HideFooter"] = true;
    ViewData["IsChat"] = true;
    ViewData["HideBreadcrumb"] = true;
    // Layout = ViewData["Layout"]?.ToString();

    
    var conversationId = (Guid)ViewBag.ConversationId;
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
}

<style>
    /* Contenedor principal (como Roles) */
    .chat-container {
        width: 100%;
        padding: 1.5rem 1rem;
    }

    #messagesList {
        height: 450px;
        overflow-y: auto;
        background: var(--cui-card-bg);
        border: 1px solid var(--cui-border-color);
    }

    .bubble {
        max-width: 55%;
        padding: .35rem .55rem;
        border-radius: .6rem;
        font-size: .9rem;
        line-height: 1.2;
        border: 1px solid var(--cui-border-color);
        word-wrap: break-word;
    }

    .bubble.mine {
        background: #cde5ff;
        color: #000;
    }

    .bubble.other {
        background: var(--cui-body-bg);
        color: var(--cui-body-color);
    }

    .bubble small {
        font-size: .7rem;
        opacity: .7;
    }
</style>



<div class="container-lg chat-container">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0">Chat</h4>
        @if (!await _UserService.CurrentUserHasRoleAsync([Env.ROLE_ADMIN, Env.ROLE_COLLAB]))
        {
            <a asp-controller="Publications"
               asp-action="Index"
               class="btn btn-secondary">
                Volver
            </a>
        }
    </div>
    

    <div id="messagesList" class="rounded p-3 mb-3">

        @if (Model != null && Model.Any())
        {
            foreach (var msg in Model)
            {
                bool isMine = msg.SenderId == Guid.Parse(userId);

                <div class="d-flex mb-2 @(isMine ? "justify-content-end" : "justify-content-start")">
                    <div class="bubble @(isMine ? "mine" : "other")">
                        @msg.Content
                        <div class="small text-end">@msg.SentAt.ToLocalTime()</div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No hay mensajes en esta conversación.</p>
        }
    </div>

    <!-- INPUT -->
    <form method="post" asp-action="Send" asp-controller="Message">
        <input type="hidden" name="conversationId" value="@conversationId"/>

        <div class="input-group">
            <input name="content" class="form-control" placeholder="Escribe un mensaje...">
            <button class="btn btn-primary">Enviar</button>
        </div>
    </form>

</div>



<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    const userId = "@userId";
    const conversationId = "@conversationId";

    // CONECTAR CON EL HUB + PASAR EL ID POR QUERY STRING
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub?conversationId=" + conversationId)
        .build();

    // Cuando llega un mensaje en tiempo real
    connection.on("ReceiveMessage", function (msg) {

        if (msg.conversationId !== conversationId) return;

        const isMine = msg.userId === userId;

        const msgDiv = document.createElement("div");
        msgDiv.classList.add("d-flex", "mb-2", isMine ? "justify-content-end" : "justify-content-start");

        msgDiv.innerHTML = `
            <div class="p-2 rounded" 
                style="max-width:70%; background:${isMine ? "#cde5ff" : "white"}; border:1px solid #ccc;">
                ${msg.message}
                <div class="small text-muted text-end">${new Date(msg.sentAt).toLocaleString()}</div>
            </div>
        `;

        document.getElementById("messagesList").appendChild(msgDiv);
        scrollToBottom();
    });

    // Iniciar conexión correctamente
    connection.start().then(function () {
        console.log("SignalR conectado.");
    });

    // Auto-scroll
    function scrollToBottom() {
        const div = document.getElementById("messagesList");
        div.scrollTop = div.scrollHeight;
    }

    scrollToBottom();
</script>
