@model PaginationResponse<ServiceDTO>
@{
    ViewBag.Title = "Publicaciones";
    ViewData["HeaderClass"] = "sticky-top";
    ViewData["HideFooter"] = false;

    ViewData["BreadcrumbParent"] = "Servicios";
    ViewData["BreadcrumbChild"] = "";

    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;

    string search = Context.Request.Query["search"].ToString();
    string currentCategory = Context.Request.Query["categoryId"].ToString();
    string fromPrice = Context.Request.Query["fromPrice"].ToString();
    string toPrice = Context.Request.Query["toPrice"].ToString();
    
    var categories = ViewBag.Categories as IEnumerable<CategoryDTO> ?? new List<CategoryDTO>();

    var sel5 = pageSize == 6 ? "selected" : "";
    var sel10 = pageSize == 12 ? "selected" : "";
    var sel20 = pageSize == 18 ? "selected" : "";
    var sel50 = pageSize == 24 ? "selected" : "";
}

<div class="container-lg">

    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0 fw-semibold text-white">Publicaciones</h2>
        <span class="ms-3 text-muted">Total: @totalCount</span>
        <a asp-action="Create" class="btn btn-primary ms-auto">Crear publicación</a>
    </div>

    <!-- Filtros -->
    <form class="row g-2 align-items-center mb-3" method="get" asp-action="Index">
        <input type="hidden" name="Page" value="@Model.CurrentPage" />
        
        <div class="col-sm-6 col-md-4">
            <input type="text" class="form-control" name="q" value="@search"
                   placeholder="Buscar por título o descripción">
        </div>

        @*
        <div class="col-md-3">
            <select id="category" name="category" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryId" selected="@(currentCategory == cat.CategoryId.ToString())">
                        @cat.Name
                    </option>
                }
            </select>
        </div>
        
        <div class="col-md-3">
            <select id="fromPrice" name="fromPrice" class="form-select">
                <option value="">Cualquier precio</option>
                <option value="0">0</option>
                <option value="50000">50000</option>
                <option value="100000">100000</option>
                <option value="250000">250000</option>
                <option value="500000">50000</option>
            </select>
        </div>
        
        <div class="col-md-3">
            <select id="toPrice" name="toPrice" class="form-select">
                <option value="">Cualquier precio</option>
                <option value="0">0</option>
                <option value="50000">50000</option>
                <option value="100000">100000</option>
                <option value="250000">250000</option>
                <option value="500000">50000</option>
            </select>
        </div>
        *@

        <div class="col-sm-3 col-md-2">
            <select name="RecordsPerPage" class="form-select" asp-for="RecordsPerPage">
                <option value="2" selected="@(Model.RecordsPerPage == 2)">2</option>
                <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
            </select>
        </div>

        <div class="col-auto">
            <button class="btn btn-outline-secondary" type="submit">Buscar</button>
            <a asp-action="Index" class="btn btn-link text-light">Limpiar</a>
        </div>
    </form>
    
    @if (Model?.List != null && Model.List.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.List)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 bg-dark text-white border-0 shadow">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Title</h5>
                            <p class="card-text text-white-50 mb-2" style="flex: 1 0 auto; overflow: hidden;">
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    @Html.Raw(item.Description.Length > 160 ? item.Description.Substring(0, 160) + "…" : item.Description)
                                }
                            </p>

                            <div class="mb-2">
                                <strong>Precio:</strong>
                                <span class="ms-1">@item.Price.ToString("C")</span>
                            </div>

                            <div class="mb-3">
                                @if (item.Categories != null && item.Categories.Any())
                                {
                                    foreach (var c in item.Categories)
                                    {
                                        <span class="badge bg-secondary me-1">@c.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Sin categorías</span>
                                }
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info flex-grow-1">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar esta publicación?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                    <a asp-controller="Conversations"
                                       asp-action="Open"
                                       asp-route-prestadorId="@item.User!.Id"
                                       asp-route-serviceId="@item.Id"
                                       class="btn btn-sm btn-success flex-grow-1">
                                        Contactar
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-muted small">
                            Publicado por:
                            <span
                                class="text-white">@item.Id.ToString().Substring(0, 8)</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">
            No hay publicaciones disponibles.
        </div>
    }

    <!-- Paginación -->
    @await Html.PartialAsync("_PaginationComponent", Model)
</div>