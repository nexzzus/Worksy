@model CategoryDTO
@{
    ViewBag.Title = "Crear categoría";
    ViewData["BreadcrumbParent"] = "Categorías";
    ViewData["BreadcrumbChild"] = "Nueva categoría";
}

<div class="container-lg">
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0 fw-semibold text-white">Crear categoría</h2>
    </div>

    <div class="card bg-dark border-0 shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Nombre</label>
                    <input asp-for="Name" class="form-control"/>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Descripción</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Crear</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
