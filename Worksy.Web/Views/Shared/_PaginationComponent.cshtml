@model Worksy.Web.Core.Pagination.Abstraction.IPagination

<nav aria-label="Page navigation example">
    <ul class="pagination justify-content-center">

        @* Primera *@
        <li class="page-item">
            <a class="page-link @(Model.CurrentPage == 1 ? "disabled" : "")"
               aria-label="Previous"
               asp-route-Page="1"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter"
               asp-action="Index">
                <span aria-hidden="true">&Lang;</span>
            </a>
        </li>

        @* Anterior *@
        <li class="page-item justify-content-center">
            <a class="page-link @(!Model.HasPrevious ? "disabled" : "")"
               asp-route-Page="@(Model.CurrentPage - 1)"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter"
               asp-action="Index">
                <span>&lang;</span>
            </a>
        </li>

        @* Páginas *@
        @foreach (int page in Model.Pages)
        {

            <li class="page-item">
                <a class="page-link @(Model.CurrentPage == page ? "disabled" : "")"
                   asp-route-Page="@(page)"
                   asp-route-RecordsPerPage="@Model.RecordsPerPage"
                   asp-route-Filter="@Model.Filter"
                   asp-action="Index">
                    @(page)
                </a>
            </li>
        }

        @* Siguiente *@
        <li class="page-item">
            <a class="page-link @(!Model.HasNext ? "disabled" : "")"
               asp-route-Page="@(Model.CurrentPage + 1)"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter"
               asp-action="Index">
                <span>&rang;</span>
            </a>
        </li>

        @* Última *@
        <li class="page-item">
            <a class="page-link @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"
               aria-label="Next"
               asp-route-Page="@Model.TotalPages"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter"
               asp-action="Index">
                <span aria-hidden="true">&Rang;</span>
            </a>
        </li>
    </ul>
</nav>
