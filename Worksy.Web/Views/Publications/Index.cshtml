@model PaginationResponse<ServiceDTO>

@{
    Layout = "_Layout";
    ViewData["HeaderClass"] = "sticky-top";
    ViewData["HideFooter"] = false;
    ViewData["Controller"] = "Publications";

    ViewBag.Title = "Servicios disponibles";

    int page = Model?.CurrentPage ?? 1;
    int pageSize = Model?.RecordsPerPage ?? 10;
    int totalCount = Model?.TotalCount ?? 0;
    int totalPages = Model?.TotalPages ?? 1;

    if (totalPages <= 0)
    {
        totalPages = (int)Math.Ceiling(totalCount / (double)(pageSize == 0 ? 1 : pageSize));
        if (totalPages == 0) totalPages = 1;
    }

    string search = Context.Request.Query["q"].ToString();
}

<!-- HEADER USUARIO NORMAL (MARKETPLACE) -->
<section class="py-5 mb-4" style="background: linear-gradient(135deg, #1b263b, #0d1b2a);">
    <div class="container-lg text-center text-white">
        <h1 class="fw-bold mb-2">Encuentra el servicio que necesitas</h1>
        <p class="text-white-50 mb-3">
            Explora servicios publicados y contacta directamente a los prestadores.
        </p>

        <!-- Barra principal de búsqueda -->
        <form method="get" asp-action="Index" class="d-flex justify-content-center gap-2">
            <input type="text"
                   name="q"
                   value="@search"
                   class="form-control w-50"
                   placeholder="Buscar servicios (ej: plomería, clases de inglés...)">

            <button type="submit" class="btn btn-primary px-4">Buscar</button>
        </form>
    </div>
</section>

<div class="container-lg">

    <!-- INFO SIMPLE PARA USER NORMAL -->
    <div class="d-flex justify-content-between align-items-center mb-3 text-white-50">
        <span>
            Resultados: @(Model?.List?.Count() ?? 0) de @totalCount
        </span>
    </div>

    @* GRID DE CARDS *@
    @{
        // si List es null, usamos una secuencia vacía para evitar null reference
        var items = Model?.List ?? Enumerable.Empty<ServiceDTO>();
    }

    @if (items.Any())
    {
        <div class="row g-4">
            @foreach (var item in items)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card bg-dark text-white h-100 shadow border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="fw-bold">@item.Title</h5>

                            <p class="text-white-50" style="flex: 1 0 auto;">
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    @Html.Raw(
                                        item.Description.Length > 150
                                            ? item.Description.Substring(0, 150) + "…"
                                            : item.Description
                                    )
                                }
                            </p>

                            <p class="fw-bold mb-1">
                                Precio: @item.Price.ToString("C")
                            </p>

                            <div class="mb-3">
                                @if (item.Categories != null && item.Categories.Any())
                                {
                                    foreach (var c in item.Categories)
                                    {
                                        <span class="badge bg-secondary me-1">@c.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Sin categorías</span>
                                }
                            </div>

                            <div class="mt-auto d-flex gap-2 flex-wrap">
                                <!-- Ver / detalle -->
                                <a asp-controller="Services" asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-info flex-grow-1">
                                    Ver
                                </a>

                                <a asp-controller="Conversations"
                                   asp-action="Open"
                                   asp-route-prestadorId="@item.User!.Id"
                                   asp-route-serviceId="@item.Id"
                                   class="btn btn-sm btn-success flex-grow-1">
                                    Contactar
                                </a>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent text-muted small">
                            Publicación #@item.Id.ToString().Substring(0, 8)
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">
            No hay publicaciones disponibles.
        </div>
    }

    @* Paginación reutilizando tu componente *@
    @await Html.PartialAsync("_PaginationComponent", Model)
</div>
